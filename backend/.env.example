# ============================================================
# 合同审批审查系统 - 环境配置模板
# 复制此文件为 .env 并修改实际值
# ============================================================

# --- 应用配置 ---
APP_NAME=contract_approval_review_system
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# --- 服务端口 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- 数据库配置 (MySQL) ---
DB_HOST=152.136.255.183
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root123
DB_NAME=contract_review
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# --- Redis 配置 ---
REDIS_HOST=152.136.255.183
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=contract_review:

# --- MinIO 配置 ---
MINIO_ENDPOINT=152.136.255.183:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contract-documents
MINIO_SECURE=false

# --- OA 系统配置 ---
OA_BASE_URL=http://localhost:8080
OA_API_KEY=your_oa_api_key
OA_TIMEOUT=30

# --- LLM 配置 ---
LLM_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- 日志配置 ---
LOG_LEVEL=DEBUG
LOG_DIR=./logs
LOG_FORMAT=json
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# --- 雪花 ID 配置 ---
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# --- 工作流配置 ---
WORKFLOW_MAX_RETRY=5
WORKFLOW_RETRY_BASE_DELAY=60
WORKFLOW_RETRY_MAX_DELAY=1800
WORKFLOW_TASK_TIMEOUT=600

# --- 安全配置 ---
SECRET_KEY=change_me_to_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- MCP 配置 ---
MCP_SERVER_NAME=contract-review-mcp
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=sse